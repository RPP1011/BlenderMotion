{
  "_comment": "Workstation: RTX 5090 (32 GB) runs ComfyUI + MiniMax H3, RTX 4090 (24 GB) runs Kimodo. Check the indices with nvidia-smi; CUDA_DEVICE_ORDER=PCI_BUS_ID makes CUDA use the same numbering.",
  "host": "127.0.0.1",
  "port": 8765,
  "data_dir": "~/chimera/orchestrator_data",
  "blender": "/opt/blender-5.0.1-linux-x64/blender",
  "cache": true,
  "gpus": {
    "gpu0": {"env": {"CUDA_DEVICE_ORDER": "PCI_BUS_ID", "CUDA_VISIBLE_DEVICES": "0"}},
    "gpu1": {"env": {"CUDA_DEVICE_ORDER": "PCI_BUS_ID", "CUDA_VISIBLE_DEVICES": "1"}}
  },
  "plan": {"backend": "heuristic"},
  "motion": {
    "backend": "kimodo",
    "device": "gpu1",
    "venv": "~/kimodo/.venv",
    "command": ["kimodo_gen"],
    "num_samples": 4,
    "max_rounds": 2,
    "ranking": {"float_height": 0.15, "max_float_frac": 0.25, "max_root_step": 0.5}
  },
  "retarget": {"backend": "blender"},
  "passes": {
    "backend": "blender",
    "still_engine": "EEVEE",
    "playblast_engine": "WORKBENCH",
    "resolution_scale": 100
  },
  "generate": {
    "backend": "comfyui",
    "device": "gpu0",
    "url": "http://127.0.0.1:8188",
    "ref2v": {"unet": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
              "lora": "minimax_h3_ref2v_turbo_8step_v1.0_768p_comfyui_bf16.safetensors",
              "steps": 8},
    "flf": {"unet": "minimax_h3_fl2va_pruned_int8_convrot.safetensors", "lora": null, "steps": 20},
    "seed": 42
  },
  "eval": {
    "backend": "dwpose",
    "python": "~/dwpose/.venv/bin/python",
    "rtmlib_device": "cpu",
    "device": null
  }
}
